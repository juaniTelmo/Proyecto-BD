#:import Window kivy.core.window.Window
#:import IconLeftWidget kivymd.uix.list.IconLeftWidget
#:import images_path kivymd.images_path
<LoginScreen>:
    name: "LoginScreen"
    BoxLayout:
        id: boxmensaje 
        orientation: "vertical"
        padding: 20
        spacing: 10
        canvas.before:
            Color:
                rgba: 0.788, 0.824, 0.824, 1
            Rectangle:
                pos: self.pos
                size: self.size
        IconLeftWidget:
            icon: "arrow-left"
            on_press: app.ir_a("HomeScreen")
        Label:
            text: "Sistema de Sueldos"
            font_size: 100
            bold: True
            color: (0, 0, 1, 1)
        TextInput:
            id: txt_usuario
            hint_text: "Correo electrónico"
            size_hint: None, None
            size: 300, 40
            pos_hint: {'center_x': 0.5}
        TextInput:
            id: txt_pass 
            hint_text: "Contraseña"
            password: True
            size_hint: None, None
            size: 300, 40
            pos_hint: {'center_x': 0.5}
        Label: 
            id: mensaje
            text: ""
            color: (1, 0, 0, 1)
        Button:
            text: "Iniciar sesión"
            size_hint: None, None
            size: 200, 50
            pos_hint: {'center_x': 0.5}
            background_color: (0.2, 0.6, 1, 1)
            on_press: root.validar_datos() 